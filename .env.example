# Copie para .env.local. Opcional: sem nada aqui o app funciona normalmente.
# Idioma e fontes de vídeo são escolhidos na tela de Configurações.

# Modo embed: com isto, o player abre o embed em vez de procurar nas fontes. Monta:
#   {base}/embed/{tmdbId}
#   {base}/embed/{tmdbId}/{temporada}/{episodio}
VITE_EMBED_BASE_URL=

# Lista de fontes padrão (JSON de { "name", "url" }), lida a cada abertura do app.
# Padrão: src/sources.json do GitHub (raw). O endereço precisa ser público.
VITE_SOURCES_URL=

# Servidor da sincronização entre TVs (padrão: o site no navegador, https://freefliix.vercel.app na TV).
VITE_API_BASE=
