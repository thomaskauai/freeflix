{
  "name": "freeflix",
  "private": true,
  "version": "0.5.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:tizen": "tsc --noEmit && vite build --mode tizen && node scripts/package-tizen.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
