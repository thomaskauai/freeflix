    "mock-addon": "node scripts/mock-addon.mjs",
    "tv:install": "node --experimental-websocket scripts/tv-install.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "hls.js": "^1.7.3",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "adbhost": "^0.0.2",
    "tizen": "github:reisxd/tizen.js#45b00106149d0c8eff74ead4a979c909dd80efd6",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vitest": "^4.1.11"
  }
}
